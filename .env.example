# ============================================================
#  Enterprise AI Knowledge & Analytics Agent - Environment
#  Copy to .env and fill in. All fields are optional.
#  Leaving API keys blank = free/local only (Ollama etc.)
# ============================================================

# --- App ---
APP_NAME="Enterprise AI Knowledge & Analytics Agent"
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- PostgreSQL (hosts BOTH relational SQL data + pgvector embeddings) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=agentdb

# --- Redis (LLM/embedding cache, sessions, rate-limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Model Gateway (LiteLLM unified - one interface, any provider) ---
# Default model used for general/generation tasks if route table has no match
MODEL_DEFAULT=ollama/llama3.1

# Default config yaml location (contains the route table + provider presets)
MODEL_CONFIG_PATH=config/models.yaml

# API keys - leave blank to use free/local providers. Fill as needed.
OPENAI_API_KEY=
OPENAI_API_BASE=            # optional custom endpoint
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Any custom OpenAI-compatible endpoint (e.g. LM Studio, vLLM, local)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# Ollama (local, free) - default
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG / Ingestion ---
EMBEDDING_DIM=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# --- SQL Agent demo schema (auto-seeded on startup) ---
SQL_SEED_DEMO=true

# --- Web Search ---
WEB_SEARCH_ENGINE=duckduckgo   # duckduckgo | serpapi | google
SERPAPI_KEY=

# --- Frontend (built/static path served by backend in prod) ---
FRONTEND_DIST=../frontend/dist
